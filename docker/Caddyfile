# Used only with `--profile caddy`, and only if the machine has no reverse proxy of its own (the
# choice is made with the server; docs/ops.md keeps both options). /v1 and /healthz are public;
# /admin is never served through the proxy: reach it over an SSH tunnel to 127.0.0.1:3000.
{$SITE_ADDRESS} {
	encode zstd gzip

	@admin path /admin /admin/*
	respond @admin "Not found" 404

	reverse_proxy server:3000
}

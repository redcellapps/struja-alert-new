# Copy to docker/.env.prod (git-ignored) and fill in. Used by compose.prod.yaml both for
# interpolation (--env-file) and as the server's environment.

# Database (the server reaches it as db:5432 inside the stack's network)
POSTGRES_PASSWORD=

# Image tag and the host port the server is published on (127.0.0.1 only)
TAG=latest
SERVER_PORT=3000

# Scraper identification: goes into the User-Agent sent to elektrodistribucija.rs. A real mailbox
# for this project, not a personal address.
SCRAPER_CONTACT_EMAIL=

# Admin page and API. Generate a token:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=
# Addresses or IPv4 CIDR ranges that may reach /admin (comma-separated). Behind a reverse proxy this
# is the client address the proxy reports, so also set TRUST_PROXY=true (and make the proxy overwrite
# X-Forwarded-For with the real client address).
ADMIN_IP_ALLOWLIST=127.0.0.1,::1
TRUST_PROXY=false
ADMIN_BASE_URL=

# Alerts: always in the log; by email when SMTP is set; by push when admin tokens are set
SMTP_URL=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ADMIN_PUSH_TOKENS=

# Phase 4
EXPO_ACCESS_TOKEN=

# Caddy profile only (no existing reverse proxy): the public host name, and the addresses allowed to
# reach /admin through it (space-separated CIDRs)
SITE_ADDRESS=
ADMIN_ALLOWED_IPS=

# Off-site backup profile: an rclone remote named "offsite" configured through the environment.
# Example (Backblaze B2):  RCLONE_CONFIG_OFFSITE_TYPE=b2  RCLONE_CONFIG_OFFSITE_ACCOUNT=...  RCLONE_CONFIG_OFFSITE_KEY=...
# Example (SFTP):          RCLONE_CONFIG_OFFSITE_TYPE=sftp RCLONE_CONFIG_OFFSITE_HOST=...  RCLONE_CONFIG_OFFSITE_USER=... RCLONE_CONFIG_OFFSITE_KEY_FILE=...
OFFSITE_REMOTE=offsite:struja-backups
OFFSITE_KEEP_DAYS=30

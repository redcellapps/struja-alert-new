# Copy to docker/.env.prod (git-ignored) and fill in. Used by compose.prod.yaml both for
# interpolation (--env-file) and as the server's environment.

# Database (the server reaches it as db:5432 inside the stack's network)
POSTGRES_PASSWORD=

# Image tag and the host port the server is published on (127.0.0.1 only)
TAG=latest
SERVER_PORT=3000

# Scraper identification: goes into the User-Agent sent to elektrodistribucija.rs. A real mailbox
# for this project, not a personal address.
SCRAPER_CONTACT_EMAIL=

# Admin page and API. Generate a token:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=
# /admin is reached over an SSH tunnel only (docs/ops.md). Through a tunnel Docker shows the bridge
# gateway as the source, hence the 172.16.0.0/12 range; the port is published on the loopback only.
ADMIN_IP_ALLOWLIST=127.0.0.1,::1,172.16.0.0/12
# true when a reverse proxy serves /v1 (the client address then comes from X-Forwarded-For)
TRUST_PROXY=false
ADMIN_BASE_URL=

# Alerts: always in the log; by email when SMTP is set; by push when admin tokens are set
SMTP_URL=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ADMIN_PUSH_TOKENS=

# Phase 4
EXPO_ACCESS_TOKEN=

# Caddy profile only (no existing reverse proxy): the public host name. /admin is never served through it.
SITE_ADDRESS=

# Off-site backup (profile "offsite", off until these are filled in; docs/ops.md "Off-site copy"):
# a private Backblaze B2 bucket, an application key limited to that bucket, and a crypt password and
# salt. Keep the crypt password AND salt in the password manager: without both the backups cannot be read.
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=
CRYPT_PASSWORD=
CRYPT_SALT=
OFFSITE_KEEP_DAYS=30

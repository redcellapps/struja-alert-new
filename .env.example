# development accepts the app's development push tokens; anything else (and nothing) is production
NODE_ENV=development
# Server
DATABASE_URL=postgres://struja:struja@localhost:5432/struja
PORT=3000
# Run the scheduled jobs (scrape 07/13/19, reminders, delivery, backup) in this process
RUN_JOBS=true
# fixtures = read the saved pages (development); http = the production scheduler requests EDS
PAGE_SOURCE=fixtures
# Development: load the saved OSM snapshots when the database has no streets yet
IMPORT_GAZETTEER=false
BACKUP_DIR=./backups
# Admin page and API (/admin): off unless a token of 16+ characters is set. Generate one, e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=
# Addresses or IPv4 CIDR ranges allowed to reach /admin (comma-separated)
ADMIN_IP_ALLOWLIST=127.0.0.1,::1
# true when a reverse proxy sits in front (the client address then comes from X-Forwarded-For)
TRUST_PROXY=false
# Public base URL of the admin page (links in alerts)
ADMIN_BASE_URL=
# Alerts (broken page, resolution below 95%, new unresolved segment, push failures, ...) go to the
# log always, by email when SMTP is set, and by push to the admin's own device(s) when tokens are set
SMTP_URL=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ADMIN_PUSH_TOKENS=
# Push delivery: expo = Expo's push service (FCM V1 / APNs; needs the FCM service account key in EAS),
# log = only log (the default outside production). EXPO_ACCESS_TOKEN is optional (locks the project's
# tokens to this server). ALLOW_REAL_PUSH_IN_DEV=true lets a development server register and push to
# a real phone (the owner's), which it refuses otherwise.
PUSH_PROVIDER=log
EXPO_ACCESS_TOKEN=
ALLOW_REAL_PUSH_IN_DEV=false
# Scraper (required for PAGE_SOURCE=http and for the collector; they refuse to run without it)
SCRAPER_CONTACT_EMAIL=

# Server
DATABASE_URL=postgres://struja:struja@localhost:5432/struja
PORT=3000
# Run the scheduled jobs (scrape 07/13/19, reminders, delivery, backup) in this process
RUN_JOBS=true
# fixtures = read the saved pages (development); http = the production scheduler requests EDS
PAGE_SOURCE=fixtures
# Development: load the saved OSM snapshots when the database has no streets yet
IMPORT_GAZETTEER=false
BACKUP_DIR=./backups
ADMIN_TOKEN=change-me
ADMIN_IP_ALLOWLIST=127.0.0.1
EXPO_ACCESS_TOKEN=
# Scraper (required for PAGE_SOURCE=http and for the collector; they refuse to run without it)
SCRAPER_CONTACT_EMAIL=

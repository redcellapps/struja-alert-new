{
  "name": "@struja/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests --coverage --reporter=default --reporter=junit --outputFile.junit=../../test-results/server/junit.xml --coverage.reportsDirectory=../../test-results/server/coverage --coverage.reporter=text-summary --coverage.reporter=lcov",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "dev:fixtures": "node --experimental-strip-types --env-file-if-exists=../../.env src/dev/rebase-fixtures.ts",
    "dev:scrape": "node --experimental-strip-types --env-file-if-exists=../../.env src/dev/scrape-now.ts",
    "dev:import-gazetteer": "node --experimental-strip-types --env-file-if-exists=../../.env src/dev/import-gazetteer.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@struja/parser": "workspace:*",
    "@struja/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "expo-server-sdk": "^8.0.0",
    "fastify": "5.12.7",
    "nodemailer": "^10.2.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "testcontainers": "12.2.1"
  }
}
